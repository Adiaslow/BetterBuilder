# ── Rust ──────────────────────────────────────────────────────────────
/rust/target/
**/*.rs.bk

# ── Archived (GPU implementation + one-off prototypes) — kept on disk, out of the repo ──
/.archive/

# ── External reference (RDKit oracle + DOCK pipeline) — external code, kept locally for
#    regenerating fixtures / speed benchmarking / the output-gap work, but not part of the deliverable.
/oracle/
/oracle_local/
/old_code/

# ── Python (venvs, bytecode, packaging/build artifacts) ───────────────
.venv/
.venv-oracle/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
*.so

# ── Editor / OS cruft ─────────────────────────────────────────────────
.DS_Store
*.swp
*~

# NOTE: Cargo.lock IS tracked (this workspace ships binaries — reproducible builds).

# AMSOL's Fortran unit files, written into whatever directory AMSOL runs in
fort.*

# certify tier build artifacts (dumpers compiled against her container libs)
validation/certify/.build/

# Divya reference ensembles: ~138MB, byte-deterministic → regenerated on demand, never committed
validation/fixtures/divya/ensembles/
validation/fixtures/divya/.build/

# Divergence-hunt generated corpus: deterministic from seed → regenerated on demand, never committed
validation/hunt/generated*.smi
# Second-seed-base ensembles (derived band) + transient analysis artifacts
validation/fixtures/divya/ensembles_base2/
validation/parity/derived_band.json
validation/parity/tfd_diag*.json
validation/parity/strain_compare.json
validation/parity/bounds_strain.json
validation/parity/_spec_tmp.json
validation/db2/.corpus_gate/
