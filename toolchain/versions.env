# Single source of truth for the toolchain BetterBuilder's C++ layer is built against.
# Sourced by every script in this directory; nothing here is duplicated elsewhere.
#
# Override BB_TOOLCHAIN_ROOT to install somewhere other than $HOME/toolchain.

BB_TOOLCHAIN_ROOT="${BB_TOOLCHAIN_ROOT:-$HOME/toolchain}"

# Versions. GCC and Boost match the environment the reference RDKit build used.
GCC_VERSION=13.4.0
BOOST_VERSION=1.82.0
EIGEN_VERSION=3.4.0

# RDKit upstream commit; see ../rdkit-patch/README.md for what diverges from it.
RDKIT_PIN=1dfc9b7a1
RDKIT_LABEL=2026.09.1pre

# Install prefixes, one per package.
GCC_PREFIX="$BB_TOOLCHAIN_ROOT/gcc-$GCC_VERSION"
BOOST_PREFIX="$BB_TOOLCHAIN_ROOT/boost-$BOOST_VERSION"
EIGEN_PREFIX="$BB_TOOLCHAIN_ROOT/eigen-$EIGEN_VERSION"
RDKIT_PREFIX="$BB_TOOLCHAIN_ROOT/rdkit-$RDKIT_LABEL"

# Scratch for build trees; not preserved.
BB_BUILD_SCRATCH="${BB_BUILD_SCRATCH:-/tmp/bb-toolchain-build-$(id -u)}"

# Python for RDKit's wrappers. The validation guard and the oracle both run on RDKit Python, and
# they must use the same patched build the engine links — not a stock wheel.
BB_PYTHON="${BB_PYTHON:-$BB_TOOLCHAIN_ROOT/guard-venv/bin/python}"
# Development headers for that Python. The system package ships only a stub, so they are staged
# here (extract python3.11-devel with rpm2cpio; no root required).
BB_PYTHON_INCLUDE="${BB_PYTHON_INCLUDE:-$BB_TOOLCHAIN_ROOT/python3.11-devel/python3.11}"

# Parallelism. Shared machines: leave headroom rather than taking every core.
BB_BUILD_JOBS="${BB_BUILD_JOBS:-32}"
